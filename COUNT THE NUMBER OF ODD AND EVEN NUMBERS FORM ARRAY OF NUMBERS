# Count odd and even numbers using for loop

numbers <- c(10, 15, 22, 33, 40, 51, 64, 75)

even_count <- 0
odd_count <- 0

for (i in numbers) {
  if (i %% 2 == 0) {
    even_count <- even_count + 1
  } else {
    odd_count <- odd_count + 1
  }
}

print(paste("Number of even numbers:", even_count))
print(paste("Number of odd numbers:", odd_count))
